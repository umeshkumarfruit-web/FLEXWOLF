SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=your_shopify_client_id
# Set SHOPIFY_API_SECRET in Firebase Secret Manager, never in the APK.
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,write_customers
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_REVEAL_ACCESS_TOKEN=false

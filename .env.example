# Non-secret build configuration. Do not put private credentials in this file.
APP_ENV=development
API_BASE_URL=https://us-central1-flexwolf-mobile-app.cloudfunctions.net
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Public Storefront API token for buyer-facing catalog, cart and checkout.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
FIREBASE_PROJECT_ID=flexwolf-mobile-app
ENABLE_SHOPIFY_CUSTOMER_SYNC=false
DEEP_LINK_SCHEME=flexwolf
DEEP_LINK_HOST=
APP_VERSION=1.0.0
BUILD_NUMBER=1
RELEASE_NOTES=

# Customer Account API public mobile/OAuth configuration.
# Client secret never goes in Flutter; keep it backend/secret-manager only.
# This is the Headless/Customer Account API client ID, not SHOPIFY_API_KEY.
# Shopify must allowlist the redirect URI for this client.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=shop.70241911041.flexwolf://customer-account/callback

# Development/staging only. Use only for temporary manual Customer Account API testing.
# Leave empty for production; production must use OAuth/PKCE and runtime secure storage.
SHOPIFY_CUSTOMER_ACCOUNT_ACCESS_TOKEN=
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_EXPIRES_AT=

# Loox public data only. Never put the Merchant API key in Flutter or this file.
LOOX_PUBLIC_STORE_ID=kIPA3sM3MY.59e70e3aec7ca82462ab50f3e8c37df302b5de0b6e10896b36c0786a2f6e0be6
